# ==============================================================================
# Mini-Games Plataforma Gaming Crossplay · Variables de Entorno (EJEMPLO)
# Copia este archivo como `.env` para configurar servicios externos.
# NUNCA subas `.env` ni claves reales al repositorio.
# ==============================================================================

# Servidor Node.js (Render / Local)
PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000

# Secreto para firmar tokens/cookies de sesión (en producción usa 32+ bytes aleatorios)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Ruta opcional de base de datos SQLite local (por defecto ./.data/minigames.sqlite)
# MINIGAMES_DB_PATH=./.data/minigames.sqlite

# ------------------------------------------------------------------------------
# OPCIÓN A · Supabase Auth + PostgreSQL (Recomendado con Custom SMTP Resend)
# 1) Configura en Supabase Dashboard -> Authentication -> SMTP Settings con Resend
# 2) Edita Authentication -> Email Templates -> Confirm signup con {{ .Token }}
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend estático (Vercel / build Vite si se separa del servidor Node)
VITE_API_ORIGIN=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# OPCIÓN B · Entrega directa OTP desde Backend Node.js (Resend HTTP o SMTP)
# IMPORTANTÍSIMO: NO uses @example.com ni onboarding@resend.dev para usuarios reales.
# Verifica tu dominio en Resend y pon tu remitente real (ej: Mini-Games <noreply@tudominio.com>)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
SMTP_FROM=

# Alternativa SMTP estándar (si prefieres SMTP en lugar de Resend API):
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Solo para tests automatizados sin proveedor externo (desactivar en producción):
# MINIGAMES_TEST_CONSOLE_OTP=0

# ------------------------------------------------------------------------------
# Google OAuth (Opcional — $0 en Google Cloud Console)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# Servidores TURN para WebRTC en redes simétricas/CGNAT móviles (Opcional)
# ------------------------------------------------------------------------------
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SHARED_SECRET=
