# ==============================================================================
# Mini-Games Plataforma Gaming Crossplay · Variables de Entorno (EJEMPLO)
# Copia este archivo como `.env` para configurar servicios externos opcionales.
# NUNCA subas `.env` ni claves reales al repositorio.
# ==============================================================================

# Servidor Node.js (Render / Local)
PORT=3000
NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3000

# Secreto para firmar tokens/cookies de sesión (en producción usa 32+ bytes aleatorios)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Ruta opcional de base de datos SQLite local (por defecto ./.data/minigames.sqlite)
# MINIGAMES_DB_PATH=./.data/minigames.sqlite

# ------------------------------------------------------------------------------
# Supabase (Opcional — para usar PostgreSQL + Supabase Auth en la nube)
# Plan Free: $0/mes (500 MB DB, 50k MAU). Ver supabase/migrations/001_initial_schema.sql
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend opcional (solo si despliegas frontend separado en Vercel apuntando a Render)
VITE_API_ORIGIN=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# Google OAuth (Opcional — $0 en Google Cloud Console)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# Entrega de correos OTP de 6 dígitos (Opcional — Resend Free 3000/mes o SMTP)
# Si no se configura, los códigos OTP se registran en la consola del servidor.
# ------------------------------------------------------------------------------
RESEND_API_KEY=
SMTP_FROM=no-reply@example.com

# ------------------------------------------------------------------------------
# Servidores TURN para WebRTC en redes simétricas/CGNAT móviles (Opcional)
# Nunca pongas credenciales TURN en el frontend: el backend las sirve vía /api/rtc/ice
# ------------------------------------------------------------------------------
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SHARED_SECRET=
